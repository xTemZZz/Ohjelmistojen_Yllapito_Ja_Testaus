{
  "name": "software-testing-assignment",
  "version": "1.0.0",
  "description": "This is a project template for students participating in Software Testing course\r at LAB University of Applied Sciences.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "mocha __test__/*test.js",
    "test:one": "mocha",
    "coverage": "nyc --reporter=lcov --reporter=text npm test",
    "coveralls": "nyc report --reporter=text-lcov | npx coveralls"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "chai": "^6.2.2",
    "coveralls": "^3.1.1",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0"
  },
  "nyc": {
  "extension": [
    ".js"
  ],
  "include": [
    "src/*.js"
  ],
  "exclude": [
    "**/__test__/**",
    "src/.internal"
  ],
  "reporter": [
    "lcov",
    "text"
  ],
  "all": true
},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petri-rantanen/AT00BY10.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/petri-rantanen/AT00BY10/issues"
  },
  "homepage": "https://github.com/petri-rantanen/AT00BY10#readme"
}
